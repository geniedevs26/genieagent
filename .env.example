# GenieAgent environment template.
# Copy to .env (Termux) or add each name as a GitHub Actions secret.
# NEVER commit .env or paste real values into chat, docs, dashboards or CSVs.

# ---------------------------------------------------------------- mode
GENIE_ENV=local
# true = prepare everything but never contact a provider
GENIE_DRY_RUN=false
GENIE_LOG_LEVEL=INFO
GENIE_MAX_LEADS_PER_RUN=50
GENIE_REQUEST_PAUSE=1.0
GENIE_HTTP_TIMEOUT=45

# ------------------------------------------------------------ Apollo
# https://developer.apollo.io/ (Settings -> API Keys)
APOLLO_API_KEY=
# Target industries / services for company discovery (comma separated)
APOLLO_KEYWORD_TAGS=web design,digital agency,ecommerce,professional services
# Worldwide by default; add countries to narrow (comma separated)
APOLLO_LOCATIONS=
# Optional Apollo employee-count buckets, e.g. 1,10 / 11,50 / 51,200
APOLLO_EMPLOYEE_RANGES=
APOLLO_PAGES=1
APOLLO_PER_PAGE=25

# ------------------------------------------------------------ Hunter
# https://hunter.io/api-keys
HUNTER_API_KEY=
HUNTER_DOMAIN_LIMIT=10

# ------------------------------------------------------------ Gemini
# Current stable model. Do not use retired gemini-1.5-* models.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------- Google Sheets
# Spreadsheet id from the URL: docs.google.com/spreadsheets/d/<THIS_ID>/edit
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_LEADS_TAB=Leads
GOOGLE_SHEETS_OUTREACH_TAB=Outreach
GOOGLE_SHEETS_ACTIVITY_TAB=Activity
# Dependency-free auth for Termux: OAuth client + refresh token
# See docs/GOOGLE_SHEETS_SETUP.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Short-lived alternative (1 hour) for a one-off manual run
GOOGLE_SHEETS_ACCESS_TOKEN=
# Alternative: path/JSON for a service account (requires pip install google-auth)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------ sender identity
GENIE_OWNER_EMAIL=
GENIE_OWNER_NAME=GenieDevs
GENIE_PORTFOLIO_URL=

# -------------------------------------------------- outreach safety
# Keep both false unless you deliberately intend to send.
OUTREACH_SEND_ENABLED=false
AUTO_OUTREACH_ENABLED=false
WHATSAPP_SEND_ENABLED=false
OUTREACH_DAILY_LIMIT=10
OUTREACH_MIN_SCORE=70
OUTREACH_FOLLOWUP_DAYS=5,12,21
SUPPRESSED_EMAILS=

# ------------------------------------------------------ Brevo SMTP
# Brevo -> SMTP & API -> SMTP tab
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Optional: transactional event tracking (delivered/bounce)
BREVO_API_KEY=

# --------------------------------------------------------- WhatsApp
# none | meta_cloud | green_api
WHATSAPP_PROVIDER=none
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0
# Meta requires an approved template for first contact outside the 24h window
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
GREEN_API_BASE_URL=https://api.green-api.com
